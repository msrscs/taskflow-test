      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "IPs distintos com falha de login",
      "description": "Quantos IPs diferentes erraram a senha no intervalo.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (ip) (count_over_time({job=\"taskflow\", event=\"login_attempt\"} | json | result=\"failure\" [$__range])))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
