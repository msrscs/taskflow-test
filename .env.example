# =============================================================================
# .env.example - MODELO das variaveis do docker-compose.yml.
#
# Este arquivo e versionado porque NAO tem segredo nenhum: so os nomes das
# variaveis e valores de exemplo. O .env de verdade fica so na sua maquina
# (esta no .gitignore e no .dockerignore).
#
# Como usar (gera valores aleatorios, nada de reaproveitar senha):
#   cp .env.example .env
#   sed -i "s/^TASKFLOW_SECRET_KEY=.*/TASKFLOW_SECRET_KEY=$(openssl rand -hex 32)/" .env
#   sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(openssl rand -hex 24)/" .env
#   sed -i "s/^TASKFLOW_ADMIN_PASSWORD=.*/TASKFLOW_ADMIN_PASSWORD=$(openssl rand -hex 12)/" .env
#   sed -i "s/^GRAFANA_ADMIN_PASSWORD=.*/GRAFANA_ADMIN_PASSWORD=$(openssl rand -hex 16)/" .env
#   git check-ignore -v .env          # confirma que o .env esta ignorado
#
# Use valores em hexadecimal (openssl rand -hex): a senha do banco entra na
# DATABASE_URL, e caracteres como / + = @ quebrariam a URL.
# =============================================================================

# Chave de sessao do Flask (obrigatoria).
TASKFLOW_SECRET_KEY=troque-por-openssl-rand-hex-32

# Senhas iniciais dos usuarios da TaskFlow (guardadas so como hash).
# Deixe vazio para nao criar o usuario.
TASKFLOW_ADMIN_PASSWORD=troque-por-openssl-rand-hex-12
TASKFLOW_ALUNO_PASSWORD=

# Banco PostgreSQL (servico "db").
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=troque-por-openssl-rand-hex-24
POSTGRES_DB=taskflow

# Senha do usuario "admin" do Grafana (profile "observabilidade").
GRAFANA_ADMIN_PASSWORD=troque-por-openssl-rand-hex-16
