# Bytecode Python (pode conter segredos de versoes antigas do codigo)
__pycache__/
*.py[cod]

# Arquivos de ambiente com segredos reais
.env
.env.*
!.env.example

# Ambientes virtuais
.venv/
venv/
env/

# Pasta codigo
codigo/

# Bancos SQLite locais
*.db
*.sqlite3

# Terraform
*.tfstate
*.tfstate.*
.terraform/

# Metadados de arquivos copiados do Windows
*:Zone.Identifier
*Zone.Identifier

# Logs da aplicacao
logs/

# Terraform: variaveis com dados reais de rede/conta e logs de crash
*.tfvars
!*.tfvars.example
crash.log

# Caches de ferramentas
.ruff_cache/
.pytest_cache/

# Relatorios gerados localmente (os oficiais ficam em docs/evidencias/)
report_*.html
report_*.md
*.sarif
# O ZAP grava zap.yaml e relatorios na pasta montada; so as regras sao versionadas
.zap/*
!.zap/rules.tsv
